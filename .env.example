# Copiar a .env y ajustar. Todos los valores son opcionales.

# MongoDB local del docker-compose (por defecto) o MongoDB Atlas:
# MONGO_URI=mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://mongo:27017
MONGO_DB=edualerta

# Contraseña de los usuarios demostrativos (perfiles F72)
DEMO_PASSWORD=edualerta

# Frecuencia inicial del pipeline programado (minutos); editable desde Administración
ETL_INTERVAL_MINUTES=60

APP_PORT=8501
